# Copy this file to `.env.local` (gitignored) and fill in your key.
# The AI assistant route (app/api/assistant) reads these server-side only.

# Your Anthropic API key — required for the assistant.
ANTHROPIC_API_KEY=

# Optional: override the model (defaults to claude-sonnet-4-6).
# ASSISTANT_MODEL=claude-sonnet-4-6

# Provider switch for Sparky: "anthropic" (default) or "openai". Both keys can be set at once —
# this one var picks which is used, so A/B swaps are a single env change + redeploy.
# ASSISTANT_PROVIDER=anthropic
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5

# Supabase Postgres connection string (Dashboard → Connect → URI) — only needed for
# `npx drizzle-kit push`; the app itself talks to the database through the Supabase API.
DATABASE_URL=

# ── Stripe billing ──────────────────────────────────────────────────────────
# Secret key (Developers → API keys). Use the test key locally, live key in Vercel.
STRIPE_SECRET_KEY=
# Webhook signing secret (Developers → Webhooks → your endpoint → Signing secret).
STRIPE_WEBHOOK_SECRET=
# Price ids of the Pro subscription (Products → Pro → the price → "API ID", starts price_…).
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
# Supabase SECRET key (Settings → API keys → secret) — used ONLY by the Stripe webhook to flip
# users.plan (it bypasses RLS; never expose it client-side).
SUPABASE_SECRET_KEY=

# Affiliate link template (set once the Digi-Key affiliate application is approved).
# The outbound product URL replaces {url}, e.g. https://track.example/c/123/456?u={url}
NEXT_PUBLIC_AFFILIATE_LINK_TEMPLATE=

# Sparky fair-use budget: max model spend per user per month, in USD. Unset or 0 = unlimited
# (the early-adopter default). Metering records regardless, so this can be flipped on anytime.
# Founder/dev allowlist (SPARKY_PRO_EMAILS) is exempt.
# SPARKY_MONTHLY_BUDGET_USD=4

# Optional: run Sparky's sub-agents ("sparks" — scoped one-block builders) on a cheaper model while
# the orchestrator stays on the flagship. Unset = same model everywhere.
# SPARK_MODEL=gpt-5.4-mini
