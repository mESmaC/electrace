{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://electrace.usnylon.com/schema/block.json",
  "title": "Electrace Block",
  "type": "object",
  "required": ["id", "name", "version", "terminals"],
  "properties": {
    "id": { "type": "string", "pattern": "^@[a-z0-9-]+/[a-z0-9-]+$" },
    "name": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "category": { "type": "string" },
    "author": { "type": "string" },
    "license": { "type": "string" },
    "glyph": { "type": "string" },
    "topology": { "enum": ["linear", "switching"] },
    "noisy": { "type": "boolean" },
    "spec": { "type": "object" },
    "transform": {
      "type": "object",
      "required": ["kind", "efficiency"],
      "properties": {
        "kind": { "const": "regulator" },
        "efficiency": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "terminals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/terminal" }
    },
    "limits": { "type": "array", "items": { "$ref": "#/$defs/limit" } },
    "schematic": { "$ref": "#/$defs/schematic" }
  },
  "$defs": {
    "range": {
      "type": "object",
      "properties": {
        "value": { "type": "number" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "unit": { "type": "string" }
      }
    },
    "terminal": {
      "type": "object",
      "required": ["id", "role", "type"],
      "properties": {
        "id": { "type": "string" },
        "role": { "enum": ["in", "out"] },
        "type": { "enum": ["power", "rail", "gnd", "signal"] },
        "v": { "$ref": "#/$defs/range" },
        "i": { "$ref": "#/$defs/range" },
        "polarity": { "enum": ["+", "-"] },
        "groundClass": { "enum": ["gnd", "agnd", "pgnd", "dgnd"] },
        "sensitive": { "type": "boolean" }
      }
    },
    "limit": {
      "type": "object",
      "required": ["field", "value", "note"],
      "properties": {
        "field": { "type": "string" },
        "value": { "type": "number" },
        "unit": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "part": {
      "type": "object",
      "required": ["ref", "type"],
      "properties": {
        "ref": { "type": "string" },
        "type": { "type": "string" },
        "value": { "type": "string" },
        "part": { "type": "string" },
        "footprint": { "type": "string" },
        "why": { "type": "string" },
        "polarized": { "type": "boolean" },
        "shielded": { "type": "boolean" }
      }
    },
    "schematic": {
      "type": "object",
      "required": ["parts", "nets"],
      "properties": {
        "parts": { "type": "array", "items": { "$ref": "#/$defs/part" } },
        "nets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "connect"],
            "properties": {
              "name": { "type": "string" },
              "connect": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
