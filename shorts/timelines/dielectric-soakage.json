   "from": 0,
   "to": 1.513,
   "set": {
    "caption": "Charge up a big capacitor."
   }
  },
  {
   "from": 1.625,
   "to": 2.628,
   "set": {
    "caption": "Now short it out —"
   }
  },
  {
   "from": 2.577,
   "to": 4.0089999999999995,
