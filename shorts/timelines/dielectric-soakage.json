    "caption": "a wire straight across it."
   }
  },
  {
   "from": 4.122,
   "to": 5.855,
   "set": {
    "caption": "The voltmeter drops to zero."
   }
  },
  {
   "from": 5.898,
   "to": 6.587,
   "set": {
    "caption": "It's dead."
   }
  },
  {
   "from": 6.664,
   "to": 8.038,
   "set": {
    "caption": "Take the wire off, walk"
   }
  },
  {
   "from": 7.976,
   "to": 9.013,
   "set": {
    "caption": "away, come back:"
   }
  },
  {
   "from": 9.091,
   "to": 10.383,
   "set": {
    "caption": "the voltage has climbed back"
   }
  },
  {
   "from": 10.333,
   "to": 11.103,
   "set": {
    "caption": "on its own."
   }
  },
  {
   "from": 11.297,
   "to": 12.437999999999999,
   "set": {
    "caption": "Nothing's connected."
   }
  },
  {
   "from": 12.585,
   "to": 14.318999999999999,
   "set": {
    "caption": "It charged itself from nothing."
   }
  },
  {
   "from": 14.571,
   "to": 15.712,
   "set": {
    "caption": "This isn't a trick —"
   }
  },
  {
   "from": 15.755,
   "to": 17.57,
   "set": {
    "caption": "it's dielectric soakage."
   }
  },
  {
   "from": 17.763,
   "to": 20.043,
   "set": {
    "caption": "A capacitor's insulator isn't perfect."
   }
  },
  {
   "from": 20.352,
   "to": 21.448,
   "set": {
    "caption": "Most of the charge sits"
   }
  },
  {
   "from": 21.351,
   "to": 22.365000000000002,
   "set": {
    "caption": "on the plates and dumps"
   }
  },
  {
   "from": 22.28,
   "to": 23.422,
   "set": {
    "caption": "the instant you short it."
   }
  },
  {
   "from": 23.534,
   "to": 25.082,
   "set": {
    "caption": "But some soaks deep into"
   }
  },
  {
   "from": 25.008,
   "to": 27.09,
   "set": {
    "caption": "the material, into slow molecules"
   }
  },
  {
   "from": 27.005,
   "to": 28.228,
   "set": {
    "caption": "that take minutes to let"
   }
  },
  {
   "from": 28.155,
   "to": 28.716,
   "set": {
    "caption": "go."
   }
  },
  {
   "from": 28.828,
   "to": 30.295,
   "set": {
    "caption": "The short empties the plates"
   }
  },
  {
   "from": 30.337,
   "to": 30.504,
   "set": {
    "caption": "—"
   }
  },
  {
   "from": 30.465,
   "to": 31.490000000000002,
   "set": {
    "caption": "not the soak."
   }
  },
  {
   "from": 31.951,
   "to": 33.788999999999994,
   "set": {
    "caption": "Seconds later that hidden charge"
   }
  },
  {
   "from": 33.751,
   "to": 35.251999999999995,
   "set": {
    "caption": "leaks back out, and the"
   }
  },
  {
   "from": 35.179,
